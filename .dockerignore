.git
.github
.vscode
.idea

node_modules
vendor

# Generated at build/run time - and public/storage / public/hot are symlinks or
# dev markers that must never leak into an image (they'd break asset loading).
public/build
public/hot
public/storage
public/fonts-manifest.dev.json

storage/app/*
!storage/app/.gitignore
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php

tests
.phpunit.result.cache
phpunit.xml
phpstan.neon

.env
.env.*
!.env.example
!.env.docker.example

Dockerfile*
docker-compose*.yml
.dockerignore

*.md
!README.md
