APP_NAME=Table4All
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CONTACT_EMAIL=contato@table4all.com.br

# LGPD: who answers for the personal data, shown on /privacidade and /termos
# (config/legal.php, docs/privacy.md). Fill these before going live.
LEGAL_COMPANY_NAME="Table4All"
LEGAL_COMPANY_DOCUMENT=
LEGAL_COMPANY_ADDRESS=
LEGAL_DPO_NAME=
LEGAL_DPO_EMAIL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=table4all
DB_USERNAME=table4all
DB_PASSWORD=table4all

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ffmpeg converts "Hoje tem!" videos; set these only if it isn't on the PATH.
# FFMPEG_BINARY=/usr/bin/ffmpeg

# Discovery page, "closest first": restaurants' addresses are found on the map with a
# Nominatim-compatible service, and visitors who don't share their location are placed
# by IP ("{ip}" is replaced). Leave a value empty to turn that lookup off.
# The IP lookup is off by default: it sends visitors' IPs abroad, so list it in the
# privacy policy before turning it on.
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# IP_LOCATION_URL=https://ipwho.is/{ip}
# FFPROBE_BINARY=/usr/bin/ffprobe

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Online payments (Stripe Connect). Webhook secrets: comma-separated (platform + Connect endpoints).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
