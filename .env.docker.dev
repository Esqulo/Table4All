# Dev config for the Docker stack - loaded by docker-compose.override.yml on
# `docker compose up`. Committed on purpose so `git clone && docker compose up`
# works the same on every machine.
#
# THROWAWAY VALUES ONLY. Never put a real secret or a production key here.
# Production uses .env.docker instead (see README).

APP_NAME=Table4All
APP_ENV=local
APP_KEY=base64:lSEID5USQ2etSE2vt5XXUz9LD+EApy0a0jxDONbTHeU=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=table4all
DB_USERNAME=table4all
DB_PASSWORD=table4all

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Vite dev server (see vite.config.ts / docker-compose.override.yml)
VITE_IN_DOCKER=true
VITE_APP_NAME=Table4All
CHOKIDAR_USEPOLLING=true
# Opening the app from a phone on the same Wi-Fi: put this machine's LAN IP in
# .env.docker.local (gitignored) and run `docker compose up -d app`:
#   VITE_DEV_HOST=192.168.x.x            (JS/CSS/HMR)
#   APP_URL=http://192.168.x.x:8080      (uploaded images)

# Online payments (Stripe Connect). Webhook secrets: comma-separated (platform + Connect endpoints).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (the platform's application in "Suas integrações"): restaurants link their account through OAuth.
# Register the redirect URL <APP_URL>/restaurant/financeiro/mercadopago/retorno and the webhook <APP_URL>/mercadopago/webhook.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
