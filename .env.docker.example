# PRODUCTION config for the Docker stack. For local development you don't need
# this file at all - `docker compose up` uses the committed .env.docker.dev.
#
# Copy this file to .env.docker, fill in real values, then run:
#   docker compose -f docker-compose.yml --env-file .env.docker run --rm app php artisan key:generate --show
# and paste the result into APP_KEY below before starting the stack with:
#   docker compose -f docker-compose.yml --env-file .env.docker up -d --build

APP_NAME=Table4All
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Matched into the "db" service by docker-compose.yml.
# DB_HOST is fixed to the "db" service name at runtime; changing it here has no effect.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=table4all
DB_USERNAME=table4all
DB_PASSWORD=change-me
# Each PHP worker keeps its database connection: opening one per request costs 25-30 ms
# (docs/performance.md, 2026-11-21 load test).
DB_PERSISTENT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# HTTPS-only session cookie: on by default when APP_URL starts with https:// (required
# in production, LGPD Art. 46). Set false only to try this stack over plain HTTP locally.
# SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Host port the app is published on (http://localhost:$APP_PORT).
APP_PORT=8080

# Host port the "db" container's Postgres is published on, e.g. for connecting
# a GUI client like DBeaver to localhost:$DB_FORWARD_PORT.
DB_FORWARD_PORT=5433

# Online payments (Stripe Connect). Webhook secrets: comma-separated (platform + Connect endpoints).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (the platform's application in "Suas integrações"): restaurants link their account through OAuth.
# Register the redirect URL <APP_URL>/restaurant/financeiro/mercadopago/retorno and the webhook <APP_URL>/mercadopago/webhook.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# LGPD: who answers for the personal data, shown on /privacidade and /termos
# (config/legal.php, docs/privacy.md). Fill these before going live.
LEGAL_COMPANY_NAME="Table4All"
LEGAL_COMPANY_DOCUMENT=
LEGAL_COMPANY_ADDRESS=
LEGAL_DPO_NAME=
LEGAL_DPO_EMAIL=
