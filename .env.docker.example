# Copy this file to .env.docker, fill in real values, then run:
#   docker compose --env-file .env.docker run --rm app php artisan key:generate --show
# and paste the result into APP_KEY below before starting the stack with:
#   docker compose --env-file .env.docker up -d --build

APP_NAME=Table4All
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Matched into the "db" service by docker-compose.yml.
# DB_HOST is fixed to the "db" service name at runtime; changing it here has no effect.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=table4all
DB_USERNAME=table4all
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true only once the app is served over HTTPS (e.g. behind a TLS-terminating
# reverse proxy) — this stack serves plain HTTP on its own, and a "true" here would
# make the browser silently drop the session cookie.
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Host port the app is published on (http://localhost:$APP_PORT).
APP_PORT=8080
